# ==============================================================================
# InsureMate Meta WhatsApp Cloud API & OpenRouter Backend Configuration
# ==============================================================================

# Meta WhatsApp Cloud API Access Token
WHATSAPP_ACCESS_TOKEN=

# WhatsApp Phone Number ID (From Meta Developer Dashboard -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Webhook Verification Token (Choose your own secret, match it in Meta Webhook config)
WHATSAPP_VERIFY_TOKEN=insuremate_secret_verify_token_2026

# Meta Graph API Version (Default: v22.0)
META_GRAPH_API_VERSION=v22.0

# ==============================================================================
# OpenRouter LLM Configuration
# ==============================================================================
# Paste your OpenRouter API Key (starts with sk-or-v1-...)
OPENROUTER_API_KEY=

# OpenRouter Base URL
LLM_BASE_URL=https://openrouter.ai/api/v1

# Chosen Model from OpenRouter:
# Examples:
# - openai/gpt-4o-mini
# - google/gemini-2.0-flash-001
# - meta-llama/llama-3.3-70b-instruct
LLM_MODEL=openai/gpt-4o-mini
