# ============================================================
# InsureMate — Frontend Environment Variables
# ============================================================
# Get your free API key at: https://openrouter.ai → Dashboard → API Keys
# It starts with:  sk-or-v1-...
VITE_OPENROUTER_API_KEY=sk-or-v1-PASTE_YOUR_KEY_HERE

# Optional overrides (defaults shown)
VITE_LLM_BASE_URL=https://openrouter.ai/api/v1
VITE_LLM_MODEL=openai/gpt-4o-mini

# Optional: your WhatsApp Business phone number (country code + number, no + or spaces)
# Example India number: 919876543210
VITE_WHATSAPP_PHONE=
