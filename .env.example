# ==============================================================================
# InsureMate Real WhatsApp + OpenRouter RAG Configuration
# ==============================================================================

# 1. FRONTEND: Your registered Meta WhatsApp Business Phone Number
# (Shown in Meta Developer Portal -> WhatsApp -> API Setup under 'From' or 'Phone number')
# Format: Country Code + Phone Number (digits only, NO '+', '-', or spaces)
# Example: 15550234567 (US Test Number) or 919876543210 (India Number)
VITE_WHATSAPP_PHONE=

# 2. BACKEND: Meta WhatsApp Cloud API Access Token
# Temporary Access Token (24 hours) or System User Permanent Token
# (Found in Meta Developer Dashboard -> WhatsApp -> API Setup -> "Temporary access token")
WHATSAPP_ACCESS_TOKEN=

# 3. BACKEND: Phone Number ID
# (Found in Meta Developer Dashboard -> WhatsApp -> API Setup -> "Phone number ID")
# Note: This is an ID string like "109823485719283", NOT your actual phone number
WHATSAPP_PHONE_NUMBER_ID=

# 4. BACKEND: WhatsApp Business Account ID (WABA ID)
# (Found in Meta Developer Dashboard -> WhatsApp -> API Setup -> "WhatsApp Business Account ID")
WHATSAPP_BUSINESS_ACCOUNT_ID=

# 5. BACKEND: Webhook Verification Token (Custom secret string)
# Enter this SAME string into Meta Developer Dashboard -> WhatsApp -> Configuration -> Webhook -> "Verify token"
WHATSAPP_VERIFY_TOKEN=insuremate_secret_verify_token_2026

# 6. Meta Graph API Version (Default: v22.0)
META_GRAPH_API_VERSION=v22.0

# ==============================================================================
# OpenRouter LLM Configuration
# ==============================================================================
# Paste your OpenRouter API Key (starts with sk-or-v1-...)
OPENROUTER_API_KEY=

# OpenRouter Base URL (Standard OpenAI-compatible endpoint)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Chosen Model from OpenRouter:
# Popular Options:
# - openai/gpt-4o-mini
# - google/gemini-2.0-flash-001
# - meta-llama/llama-3.3-70b-instruct
# - anthropic/claude-3.5-haiku
LLM_MODEL=openai/gpt-4o-mini
